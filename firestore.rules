rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Role-Based Access Control (RBAC) - checks admin registry or user profile role without hardcoded emails
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins collection (protected administration registry)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
    }

    // Users profile collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Doctors and Departments directory collections (publicly readable for patients and AI assistant)
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      // Patients and admins can read bookings; public can check slot availability
      allow read: if true;

      // Anyone can create an appointment (registered user or guest via AI assistant / portal)
      allow create: if true;

      // Admins can update any booking; patients can update their own
      allow update: if isAdmin() || (isSignedIn() && (
        resource.data.patientEmail == request.auth.token.email ||
        resource.data.patientId == request.auth.uid
      ));

      // Admins can delete any booking; patients can cancel/delete their own
      allow delete: if isAdmin() || (isSignedIn() && (
        resource.data.patientEmail == request.auth.token.email ||
        resource.data.patientId == request.auth.uid
      ));
    }
  }
}
